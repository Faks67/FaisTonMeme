{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.SignalR.Internal.DefaultHubDispatcher": "None"
    }
  },
  "AllowedHosts": "*",
  "FaisTonMeme": {
    "DataFolder": "data",
    "RefreshIntervalHours": 6,
    "AdminPassword": "",
    "Imgflip": {
      "Enabled": true
    },
    "Memegen": {
      "Enabled": true
    },
    "Openverse": {
      "Enabled": true,
      "Queries": [
        "funny cat",
        "funny dog",
        "funny animal",
        "surprised cat",
        "confused dog",
        "grumpy cat",
        "sleepy dog",
        "pug",
        "funny bird",
        "owl",
        "goat",
        "llama",
        "squirrel",
        "frog",
        "funny horse"
      ],
      "PagesPerQuery": 12,
      "RefreshHours": 24
    },
    "YouTube": {
      "ApiKey": "",
      "Queries": [
        "meme #shorts",
        "memes français #shorts"
      ],
      "RegionCode": "FR",
      "Language": "fr",
      "MaxAgeDays": 7,
      "MaxResultsPerQuery": 25
    },
    "Klipy": {
      "ApiKey": "",
      "Locale": "fr",
      "ContentFilter": "high"
    }
  }
}
