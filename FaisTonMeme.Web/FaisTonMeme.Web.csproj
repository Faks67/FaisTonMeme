<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaisTonMeme.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modèles de départ, utilisés tant que la bibliothèque est vide -->
    <None Update="Seed\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Données locales (bibliothèque, propositions) : jamais publiées -->
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

</Project>
